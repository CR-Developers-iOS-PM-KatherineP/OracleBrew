# Xcode user state
xcuserdata/
*.xcuserstate
*.xcscmblueprint

# Build
build/
DerivedData/
*.ipa
*.dSYM.zip
*.dSYM

# Swift Package Manager
.swiftpm/
.build/

# CocoaPods (if added later)
Pods/

# fastlane
fastlane/report.xml
fastlane/screenshots/**/*.png
fastlane/test_output

# macOS
.DS_Store

# Secrets
*.p8
*.p12
*.mobileprovision
.env

# Graphify: local-only cost, graph itself is committed
graphify-out/cost.json
graphify-out/**/cost.json
# The hook snapshots the graph into a dated folder on every rebuild — ~1.2 MB a
# time, and the graph is rebuilt from source anyway. History lives in the commits.
graphify-out/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/

# Localization working files — scratch fragments from a translation pass.
loc-work/

# Python bytecode, e.g. from running the CI signing script locally
__pycache__/
*.pyc
