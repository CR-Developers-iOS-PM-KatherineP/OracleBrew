      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شرح أوريون وضعي بدقة لا تُصدَّق. أصبح كل شيء واضحًا تمامًا بعدها."
