    "oracle.cassian.bio" : {
      "comment" : "Oracle profile 'About' text.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أمضى كاسيان عقودًا في إتقان رموز التاروت. تكشف قراءاته الدوافع الخفية، والنتائج المحتملة، والخطوات العملية القادمة. يلجأ إليه العملاء لمسائل الخيارات المهنية والعلاقات والشؤون المالية والتحولات الكبرى في الحياة."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cassian has spent decades mastering tarot symbolism. His readings reveal hidden motivations, likely outcomes, and practical next steps. Clients seek him for career choices, relationships, finances, and life transitions."
          }
        }
      }
    },
