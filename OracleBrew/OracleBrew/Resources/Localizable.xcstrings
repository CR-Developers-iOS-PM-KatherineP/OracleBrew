    },
    "oracle.serena.prompt.1" : {
      "comment" : "Tappable suggested question in a chat with this oracle.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ما الذي لا يقوله قلبي بصوت عالٍ؟"
