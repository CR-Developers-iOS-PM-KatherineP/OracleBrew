    "oracle.aurora.review.1" : {
      "comment" : "Review of Aurora.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فسّرت أورورا حلمًا كان يتكرر معي منذ سنوات. فجأة اتضح كل شيء."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aurora interpreted a recurring dream I'd had for years. Everything suddenly clicked."
          }
        }
      }
    },
    "oracle.aurora.review.2" : {
      "comment" : "Review of Aurora.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دافئة، صبورة، وبصيرتها لا تُصدَّق."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warm, patient, and incredibly insightful."
          }
        }
      }
    },
    "oracle.aurora.review.3" : {
      "comment" : "Review of Aurora.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كانت تفسيراتها عميقة ومطمئنة. غادرت وأنا أشعر بخفة وثقة أكبر بكثير."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her explanations were thoughtful and comforting. I left feeling lighter and much more confident."
          }
        }
      }
    },
    "oracle.aurora.review.4" : {
      "comment" : "Review of Aurora.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شعرت أن القراءة ذات معنى عميق دون أي مبالغة. أنصح بها بشدة."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The reading felt deeply meaningful without being dramatic. Highly recommend."
