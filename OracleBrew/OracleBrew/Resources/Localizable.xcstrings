    "oracle.elara.bio" : {
      "comment" : "Oracle profile 'About' text.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تساعد إيلارا الناس على إعادة التواصل مع ذواتهم الحقيقية. تكشف الأنماط العاطفية ودروس الروح ونقاط القوة الخفية، وتقدم إرشادًا رحيمًا للنمو الشخصي والتغيير ذي المعنى."
