    "oracle.lyra.bio" : {
      "comment" : "Oracle profile 'About' text.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "توظّف ليرا طاقة الكريستال لكشف العوائق العاطفية والفرص الخفية والقوى العميقة المؤثرة في حياتك. تُعد قراءاتها مفيدة بشكل خاص للشفاء والعلاقات واكتشاف الذات والتحول الشخصي."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lyra channels the energy of crystals to reveal emotional blocks, hidden opportunities, and the deeper forces influencing your life. Her readings are especially helpful for healing, relationships, self-discovery, and personal transformation."
          }
        }
      }
    },
