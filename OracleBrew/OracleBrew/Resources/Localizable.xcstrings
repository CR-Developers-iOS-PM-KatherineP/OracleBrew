    "oracle.serena.review.1" : {
      "comment" : "Review of Serena.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شعرت بأن قراءة سيرينا شخصية للغاية. فهمت مشاعر لم أذكرها حتى، ومنحتني منظورًا جديدًا تمامًا."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serena's reading felt incredibly personal. She understood emotions I hadn't even mentioned and gave me a completely new perspective."
          }
        }
      }
    },
    "oracle.serena.review.2" : {
      "comment" : "Review of Serena.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هادئة ورحيمة ودقيقة بشكل مذهل. كل كلمة لامست شيئًا بداخلي."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calm, compassionate, and amazingly accurate. Every word resonated."
          }
        }
      }
    },
    "oracle.serena.review.3" : {
      "comment" : "Review of Serena.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جئت بأسئلة عن علاقتي وغادرت بوضوح تام. بدت بصيرتها طبيعية لا مُعدّة سلفًا، وشرحت كل شيء بلطف."
