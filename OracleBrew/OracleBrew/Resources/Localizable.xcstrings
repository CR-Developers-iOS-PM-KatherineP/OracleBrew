        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nyx specializes in uncovering hidden fears, unresolved emotions, and the unseen influences affecting your decisions. Her readings help clients move through uncertainty with confidence and self-awareness."
          }
        }
      }
    },
