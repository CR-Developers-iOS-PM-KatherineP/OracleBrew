    "oracle.mira.bio" : {
      "comment" : "Oracle profile 'About' text.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تمتلك ميرا قدرة فائقة على إدراك الروابط بين خيارات الماضي وظروف الحاضر واحتمالات المستقبل. تساعد قراءاتها العملاء على اكتشاف فرص جديدة، وتجاوز الشك، والدخول بثقة إلى الفصل التالي من حياتهم."
