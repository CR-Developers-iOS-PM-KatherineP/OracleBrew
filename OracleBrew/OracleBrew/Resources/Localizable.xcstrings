    "oracle.aurora.bio" : {
      "comment" : "Oracle profile 'About' text.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تؤمن أورورا بأن كل حلم يحمل رسالة تنتظر من يفهمها. تتخصص في تفسير الأحلام والحدس والشفاء العاطفي وأنماط اللاوعي. تساعد قراءاتها الناس على اكتشاف مخاوفهم الخفية، والتعرف على نقاط قوتهم الداخلية، وفهم الرسائل التي تحاول عقولهم إيصالها بالفعل بشكل أعمق."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aurora believes that every dream carries a message waiting to be understood. She specializes in dream interpretation, intuition, emotional healing, and subconscious patterns. Her readings help people uncover hidden fears, recognize inner strengths, and better understand the messages their minds are already trying to share."
          }
        }
      }
    },
    "oracle.aurora.name" : {
      "comment" : "Oracle display name.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أورورا"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aurora"
          }
        }
      }
    },
    "oracle.aurora.profession" : {
      "comment" : "Line under the oracle's name.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هامسة الأحلام"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dream Whisperer"
          }
        }
      }
    },
    "oracle.aurora.prompt.1" : {
      "comment" : "Tappable suggested question in a chat with this oracle.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ماذا يعني حلمي المتكرر؟"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What does my recurring dream mean?"
