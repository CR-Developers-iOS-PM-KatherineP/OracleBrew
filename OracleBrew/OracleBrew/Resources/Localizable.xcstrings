    "oracle.seraphine.bio" : {
      "comment" : "Oracle profile 'About' text.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تقدم سيرافين قراءات رحيمة تتمحور حول الشفاء والتشجيع والوضوح العاطفي. تساعد الناس على تخطي العلاقات وشؤون الأسرة وتقدير الذات وتحولات الحياة الصعبة."
