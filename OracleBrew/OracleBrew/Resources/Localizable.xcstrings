    "oracle.raven.bio" : {
      "comment" : "Oracle profile 'About' text.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتمتع رايفن بموهبة إدراك الروابط غير المرئية بين الأحداث والخيارات واحتمالات المستقبل. تساعد الناس على فهم ديناميكيات العلاقات وأنماط الأسرة والقرارات المصيرية والتغيرات المفاجئة في الحياة. تشجع قراءاتها على التصرف المدروس، بينما تكشف فرصًا قد تمر دون أن يلاحظها أحد."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raven is gifted at recognizing the invisible connections between events, choices, and future possibilities. She helps people understand relationship dynamics, family patterns, major decisions, and unexpected life changes. Her readings encourage thoughtful action while revealing opportunities that may otherwise go unnoticed."
          }
        }
      }
    },
