        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seraphine offers compassionate readings centered on healing, encouragement, and emotional clarity. She helps people navigate relationships, family matters, self-worth, and life's difficult transitions."
          }
        }
      }
    },
