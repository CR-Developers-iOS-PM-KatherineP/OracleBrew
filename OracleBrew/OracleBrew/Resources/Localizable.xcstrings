    "oracle.orion.bio" : {
      "comment" : "Oracle profile 'About' text.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يقرأ أوريون لغة النجوم ليكشف التوقيت والفرص والتأثيرات الخفية التي تشكّل حياتك. يتخصص في القدر وقرارات المهنة والهدف الشخصي والتحولات المهمة في الحياة. تجمع قراءاته بين رمزية التنجيم العريقة والإرشاد العملي، لمساعدة الناس على المضي قدمًا بثقة."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orion reads the language of the stars to reveal timing, opportunities, and hidden influences shaping your life. He specializes in destiny, career decisions, personal purpose, and important life transitions. His readings combine ancient astrological symbolism with practical guidance, helping people move forward with confidence."
          }
        }
      }
    },
    "oracle.orion.name" : {
