    "oracle.elias.bio" : {
      "comment" : "Oracle profile 'About' text.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُعرف إلياس بحضوره الهادئ وقدرته الفائقة على مساعدة الناس على إعادة التواصل مع حكمتهم الداخلية. تركز قراءاته على النمو الروحي والشفاء وهدف الحياة والقرارات الصعبة وتجاوز الاضطراب العاطفي. غالبًا ما يصف العملاء إرشاده بأنه يمنحهم الثبات والرفعة والطمأنينة العميقة."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elias is known for his calm presence and remarkable ability to help people reconnect with their inner wisdom. His readings focus on spiritual growth, healing, life purpose, difficult decisions, and overcoming emotional uncertainty. Clients often describe his guidance as grounding, uplifting, and deeply reassuring."
          }
        }
      }
    },
    "oracle.elias.name" : {
      "comment" : "Oracle display name.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
