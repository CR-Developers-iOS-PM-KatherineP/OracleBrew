    "oracle.nyx.bio" : {
      "comment" : "Oracle profile 'About' text.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتخصص نيكس في كشف المخاوف الخفية والمشاعر غير المحلولة والتأثيرات غير المرئية التي تشكل قراراتك. تساعد قراءاتها العملاء على تجاوز الشك بثقة ووعي ذاتي."
          }
