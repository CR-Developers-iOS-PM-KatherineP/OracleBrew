    "oracle.zephyr.bio" : {
      "comment" : "Oracle profile 'About' text.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يؤمن زفير بأن كل تغيير يبدأ بعلامات خفية. تكشف قراءاته الحدسية التوقيت والفرص والتأثيرات الخفية، ما يساعد العملاء على المضي قدمًا بثقة خلال فترات الشك."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zephyr believes every change begins with subtle signs. His intuitive readings reveal timing, opportunities, and hidden influences, helping clients move forward with confidence during periods of uncertainty."
          }
        }
      }
    },
