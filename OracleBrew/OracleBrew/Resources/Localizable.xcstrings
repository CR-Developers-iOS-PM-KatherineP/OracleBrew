    "oracle.serena.bio" : {
      "comment" : "Oracle profile 'About' text.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُعرف سيرينا بارتباطها العميق بطاقة القمر والأحلام والعلامات العاطفية الخفية. موهبتها هي كشف ما يتركه الناس غالبًا دون قول، من مخاوف صامتة ومشاعر سرية وأنماط حياة متكررة، والمعنى الحقيقي وراء المواقف المُحيّرة. تتخصص في الحب والنمو الشخصي ومفترقات الحياة والشفاء العاطفي. قراءاتها لطيفة وحدسية، وتركز على مساعدة الناس على الثقة بطريقهم الخاص."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serena is known for her deep connection with moon energy, dreams, and hidden emotional signs. Her gift is uncovering what people often leave unsaid—quiet fears, secret feelings, repeating life patterns, and the true meaning behind confusing situations. She specializes in love, personal growth, life crossroads, and emotional healing. Her readings are gentle, intuitive, and focused on helping people trust their own path."
          }
        }
      }
    },
    "oracle.serena.name" : {
      "comment" : "Oracle display name.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيرينا"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serena"
