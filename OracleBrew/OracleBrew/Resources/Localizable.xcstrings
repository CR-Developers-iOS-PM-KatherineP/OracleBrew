    "oracle.serena.prompt.2" : {
      "comment" : "Tappable suggested question in a chat with this oracle.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أي طريق يجب أن أسلكه من هنا؟"
