        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I came with questions about my relationship and left with clarity. Her insight felt natural rather than scripted, and she explained everything with kindness."
          }
        }
      }
    },
    "oracle.serena.review.4" : {
      "comment" : "Review of Serena.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تمتلك طاقة هادئة للغاية. ساعدني الحديث مع سيرينا على التوقف عن الإفراط في التفكير والثقة أخيرًا بحدسي."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "She has such peaceful energy. Talking to Serena helped me stop overthinking and finally trust my intuition."
          }
        }
      }
    },
