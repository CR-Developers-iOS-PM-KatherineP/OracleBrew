{
  "sourceLanguage": "en",
  "strings": {
    "CFBundleName": {
      "comment": "Bundle name",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "OracleBrew"
          }
        }
      }
    },
    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستخدم OracleBrew الكاميرا لتصوير فنجان قهوتك من أجل القراءة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OracleBrew uses the camera to photograph your coffee cup for a reading."
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحفظ OracleBrew صورة فنجان قراءتك في معرض صورك عند الضغط على «حفظ»."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OracleBrew saves your reading's cup photo to your library when you tap Save."
          }
        }
      }
    },
    "NSUserTrackingUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسمح بالتتبّع ليتمكّن Oracle Brew من تخصيص قراءاتك وعرض عروض تناسبك فعلاً."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow tracking so Oracle Brew can personalise your readings and show you offers that actually fit you."
          }
        }
      }
    }
  },
  "version": "1.0"
}
