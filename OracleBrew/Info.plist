<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The rest of the Info.plist is still generated from build settings; this
	     file exists for the launch screen and the two keys below. Xcode's
	     INFOPLIST_KEY_UILaunchScreen_* settings can't express the background
	     colour — Generation=YES writes an empty dict over it — and without a
	     colour the launch screen is white, which flashes before the dark
	     splash. -->
	<!-- The app talks to its backend over HTTPS and does nothing else with
	     crypto, which is exempt. Declared here so App Store Connect stops
	     asking the export-compliance question on every single build. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>

	<!-- Facebook's SDK asserts at launch when these are absent, so they ship as
	     placeholders and the sink stays off until they are real (see
	     AnalyticsConfig.isFacebookReady). They have to live in a base plist:
	     with GENERATE_INFOPLIST_FILE = YES, Xcode only maps a known allowlist of
	     INFOPLIST_KEY_* settings and would drop these. -->
	<key>FacebookAppID</key>
	<string>FACEBOOK_APP_ID</string>
	<key>FacebookClientToken</key>
	<string>FACEBOOK_CLIENT_TOKEN</string>
	<key>FacebookDisplayName</key>
	<string>OracleBrew</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>fbFACEBOOK_APP_ID</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
